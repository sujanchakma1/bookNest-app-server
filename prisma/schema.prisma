generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum BorrowStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  password     String?   // null for social-login-only accounts
  firebaseUid  String?   @unique
  photoURL     String?
  role         Role      @default(STUDENT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  borrowRequests BorrowRequest[]
  favorites      Favorite[]
  notifications  Notification[]
}

model Category {
  id    String @id @default(uuid())
  name  String @unique
  books Book[]
}

model Book {
  id           String    @id @default(uuid())
  title        String
  author       String
  description  String?
  coverUrl     String?
  totalCopies  Int       @default(1)
  availableCopies Int    @default(1)
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  borrowRequests BorrowRequest[]
  favorites      Favorite[]

  @@index([categoryId])
}

model BorrowRequest {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  bookId      String
  book        Book          @relation(fields: [bookId], references: [id])
  status      BorrowStatus  @default(PENDING)
  borrowDate  DateTime?
  dueDate     DateTime?
  returnDate  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([bookId])
}

model Favorite {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  bookId  String
  book    Book   @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
