generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String?
  firebaseUid    String?         @unique
  photoURL       String?
  role           Role            @default(STUDENT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  borrowRequests BorrowRequest[]
  favorites      Favorite[]
  notifications  Notification[]
}

model Category {
  id    String @id @default(uuid())
  name  String @unique
  books Book[]
}

model Book {
  id              String          @id @default(uuid())
  title           String
  author          String
  description     String?
  coverUrl        String?
  totalCopies     Int             @default(1)
  availableCopies Int             @default(1)
  categoryId      String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  category        Category        @relation(fields: [categoryId], references: [id])
  borrowRequests  BorrowRequest[]
  favorites       Favorite[]

  @@index([categoryId])
}

model BorrowRequest {
  id         String       @id @default(uuid())
  userId     String
  bookId     String
  status     BorrowStatus @default(PENDING)
  borrowDate DateTime?
  dueDate    DateTime?
  returnDate DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  book       Book         @relation(fields: [bookId], references: [id])
  user       User         @relation(fields: [userId], references: [id])
  fine            Int      @default(0)
  reminderSent    Boolean  @default(false)

  @@index([userId])
  @@index([bookId])
}

model Favorite {
  id     String @id @default(uuid())
  userId String
  bookId String
  book   Book   @relation(fields: [bookId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, bookId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum Role {
  STUDENT
  ADMIN
}

enum BorrowStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum NotificationType {
  INFO
  REMINDER
  SUCCESS
  WARNING
  OVERDUE
}